# Origine public du site, sans chemin ni barre finale. Sert au canonical, à og:url, au JSON-LD et au sitemap.
# Par défaut : http://localhost:3000. En production : https://ododex.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identifiant d'éditeur Google AdSense (ca-pub- suivi de 16 chiffres). Facultatif : sans lui, le script
# n'est pas chargé et le bouton « Gérer les cookies » n'apparaît pas.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Bloc d'annonce (10 chiffres). Facultatif : sans lui, AdSlot n'affiche rien.
NEXT_PUBLIC_ADSENSE_SLOT=
